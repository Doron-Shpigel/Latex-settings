%general environmetns
\newenvironment{colorparagraph}[2][red]
{%here comes what is processed before
\color{#1}\noindent\textbf{#2}\hspace{1em}\newline}%\ignorespaces}
{%and here what is processed after
\par}
\newcounter{QuestionCounter}
\newenvironment{Question}{
    \refstepcounter{QuestionCounter}%
    \noindent שאלה \theQuestionCounter.%
    \newline\indent
}

\newcommand{\frameparagraph}[3][black]{
    \begin{center}
        \noindent\fcolorbox{#1}{white}{\parbox{0.9\textwidth}%here comes what is processed before
        {\textbf{#2}\newline%title
        #3
        }
        \par
        }
    \end{center}
    }
    \renewcommand\labelitemi{$\vcenter{\hbox{$\bullet$}}$}

\newcommand{\qq}[1]{\say{\textit{#1}}}

\newcommand{\warpfig}[2]{\vspace*{-\baselineskip}
    \begin{minipage}{\textwidth}
    \begin{wrapfigure}{l}{0.4\textwidth}
        \includegraphics[width=0.4\textwidth]{#1}
    \end{wrapfigure}\hphantom{1pt}\newline
    #2
    \hphantom{100pt}\newline
    \end{minipage}}

\renewcommand*\showkeyslabelformat[1]{\fbox{\normalfont\small\ttfamily\texthebrew{#1}}}

%Math environments
\theoremstyle{plain}
\newtheorem{theorem}{משפט}[section]
%\theoremstyle{definition}
\newtheoremstyle{styledef}%
{9pt}% Space above
{9pt}% Space below 
{\itshape}% Body font
{\parindent}% Indent amount
{\large\bfseries\color{cadmiumgreen}}% Theorem head font
{:}% Punctuation after theorem head
{ }% Space after theorem head
{}% Theorem head spec (can be left empty, meaning ‘normal’)
\theoremstyle{styledef}
\newtheorem{defn}[theorem]{הגדרה}
\newcommand{\statedefsolid}[2][\textwidth]{
    \par\noindent\tikzstyle{mybox} = [fill=yellow!20,thick,rectangle,inner sep=6pt,path picture={\fill [green!50!black] ([xshift=-6.15cm]path picture bounding box.north) rectangle (path picture bounding box.south west);}]
    \begin{tikzpicture}
        \node [mybox] (box)
        {%
        \begin{minipage}{#1}{\selectlanguage{hebrew}#2}\end{minipage}
        };
    \end{tikzpicture}
}
\newcommand{\statetheoremsolid}[2][\textwidth]{
        \par\noindent\tikzstyle{mybox} = [draw=amber,fill=gray!17,thick,rectangle,rounded corners,inner sep=6pt]
        \begin{tikzpicture}
            \node [mybox] (box){%
            \begin{minipage}{#1}{\selectlanguage{hebrew}#2}\end{minipage}
            };
        \end{tikzpicture}
}
        
\newcommand{\newdef}[2]{
            \hrule
            \statedefsolid{
                \begin{defn}
                    \label{#1}
                    \textcolor{cadmiumgreen}{\large{#1}}\newline
                    #2
                \end{defn}
                }
                \hrule
}
